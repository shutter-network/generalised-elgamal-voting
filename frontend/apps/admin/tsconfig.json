{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shutter-governance-protocol/shared": ["../../shared/src"],
      "@shutter-governance-protocol/shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
