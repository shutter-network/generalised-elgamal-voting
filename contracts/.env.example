# RPC endpoints used by foundry.toml aliases.
# GNOSIS_RPC_URL=https://rpc.gnosischain.com
# CHIADO_RPC_URL=https://rpc.chiadochain.net

# Optional verifier API key used by the gnosis and chiado verifier configs.
# GNOSISSCAN_API_KEY=

# Deployer private key.
# Required for PublishElection.s.sol.
# Used by Deploy.s.sol to derive VOTE_MANAGER when VOTE_MANAGER is unset.
# PRIVATE_KEY=

# Registry/election admin.
# Required by Deploy.s.sol only when PRIVATE_KEY is unset.
# Optional for DeployAndPublishLocal.s.sol; defaults to msg.sender.
# VOTE_MANAGER=

# Keyper configuration for Deploy.s.sol.
# Use either KEYPERS or KEYPER_COUNT plus KEYPER_1..KEYPER_N.
# DeployAndPublishLocal.s.sol reads KEYPER_1 and KEYPER_2 (defaulting to admin).
# KEYPERS=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222,0x3333333333333333333333333333333333333333
# KEYPER_COUNT=3
# KEYPER_1=0x1111111111111111111111111111111111111111
# KEYPER_2=0x2222222222222222222222222222222222222222
# KEYPER_3=0x3333333333333333333333333333333333333333

# Optional threshold for Deploy.s.sol. Defaults to the full keyper count.
# KEYPER_THRESHOLD=2

# Existing deployment addresses consumed by PublishElection.s.sol.
# REGISTRY=
# KEYPER_SET=

# Election parameters.
# Required by PublishElection.s.sol; optional for DeployAndPublishLocal.s.sol (defaults shown).
# VOTING_START and VOTING_END are Unix timestamps.
# VOTING_START=
# VOTING_END=
# SELF_SUBMIT_FEE=10000000000000000
# NUM_CANDIDATES=3
# BUDGET=1
# PK_WR=

# Roles/actors for the election.
# Required by PublishElection.s.sol; optional for DeployAndPublishLocal.s.sol (default to admin).
# TALLY_AGGREGATOR=
# VOTE_PROXY=
