# Deployment identities + config for the docker-compose stacks (RUNNING.md).
#
# Don't hand-edit this — run `python scripts/gen_deploy_env.py` to generate a
# coherent `deploy/.env` (keyper keys matching the config, coordinator address
# matching its key, etc.). This file documents every variable.
#
# All identities are secp256k1 (Ethereum) private keys, 0x-hex. An identity's
# 20-byte address is what the data layer checks writes against.

# --- write-authorization identities (both backends) ------------------------ #
ADMIN_SIGNING_KEY=0x<64 hex>          # registers/cancels; on chain the adminAddr
ADMIN_API_TOKEN=<url-safe token>      # bearer token gating the admin HTTP service (:8300)
AGGREGATOR_SIGNING_KEY=0x<64 hex>     # publishes aggregate + result; bootstraps + triggers keypers for decryption
AGGREGATOR_IDENTITY=<40 hex>          # aggregator's address (no 0x); keypers pin it as a trusted bootstrapper
GATEWAY_SIGNING_KEY=0x<64 hex>        # submits ballots (chain: msg.sender)
COORDINATOR_SIGNING_KEY=0x<64 hex>    # drives DKG (bootstraps+triggers keypers for DKG), relays keyper writes
COORDINATOR_IDENTITY=<40 hex>         # coordinator's address (no 0x); keypers pin it
COORDINATOR_API_TOKEN=<url-safe token>  # keypers present this to the coordinator relay (:8400)

# --- committee keyper identities ------------------------------------------- #
# Each must equal the signing_key of the matching entry in sample-election.json.
KEYPER1_KEY=0x<64 hex>
KEYPER2_KEY=0x<64 hex>
KEYPER3_KEY=0x<64 hex>
# Keyper URLs are part of the election config (sample-election.json), stored in the
# data layer on every backend — including the KeyperSet contract on chain — so there
# is no separate endpoint env var.

# --- blockchain backend only ----------------------------------------------- #
# Relayer that pays gas for keyper meta-tx writes (Option A). Holds no on-chain
# role — the contract attributes the keyper via ecrecover.
GEG_RELAYER_KEY=0x<64 hex>
GEG_CHAIN_RPC=http://anvil:8545
GEG_REGISTRY_ADDRESS=0x<address>      # set after `deploy-registry` (RUNNING.md)
