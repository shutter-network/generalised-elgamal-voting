# Coordinator env — for the standalone coordinator attached to an EXTERNAL data layer
# (deploy/docker-compose.coordinator.yml). The bundled backend stacks (db / chain) carry
# their coordinator settings in deploy/.env instead; this file exists because that
# topology has a different owner for the bulletin board.
#
# Run:  docker compose -f deploy/docker-compose.coordinator.yml \
#         --env-file deploy/.env.coordinator up -d --build

# The external data layer's base URL, serving the port contract over HTTP. The
# coordinator both reads and writes here — it is the sole writer, since keypers relay
# their signed writes through it. Keep this surface reachable only by the coordinator;
# keypers are given the read-only /port mount instead (GEG_API_URL in .env.keyperN).
GEG_DATA_LAYER_URL=http://host.docker.internal:3002

# Coordinator identity (0x-hex secp256k1). Two roles in one key:
#   * every keyper pins its address as COORDINATOR_IDENTITY and accepts bootstrap from
#     nobody else;
#   * it signs the published result, so its address MUST equal each election config's
#     result_publisher_key, or the published result is rejected.
COORDINATOR_SIGNING_KEY=0x<64 hex>

# Bearer token the keypers present when relaying writes. The coordinator pushes each
# keyper its own token over the sealed /auth/bootstrap channel; this is the relay's own
# secret. Fail-closed: unset and no keyper can write.
COORDINATOR_API_TOKEN=<random string>

# Published port. Every keyper must be able to reach it (it is where their writes go).
COORDINATOR_PORT=8400

# Seconds between data-layer polls. Drives how quickly a newly registered election
# starts its DKG, and how fast the tally advances once voting closes.
COORDINATOR_POLL_S=30
