# Admin / operator-stack identities for the docker-compose backends (RUNNING.md).
# Keypers run SEPARATELY — their env is `.env.keyper.example` — so no keyper keys here.
#
# Don't hand-edit this — run `python scripts/gen_deploy_env.py` to generate a
# coherent `deploy/.env` (this admin stack) plus a per-keyper `deploy/.env.keyper{1,2,3}`.
# This file documents the admin/operator-stack variables.
#
# All identities are secp256k1 (Ethereum) private keys, 0x-hex. An identity's
# 20-byte address is what the data layer checks writes against.

# --- write-authorization identities (both backends) ------------------------ #
ADMIN_SIGNING_KEY=0x<64 hex>          # registers/cancels; on chain the adminAddr, and the
                                      # same EOA the admin wallet signs with (auth model B)
GATEWAY_SIGNING_KEY=0x<64 hex>        # submits ballots (chain: msg.sender)
COORDINATOR_SIGNING_KEY=0x<64 hex>    # the single keyper-facing orchestrator. Sole keyper
                                      # bootstrapper; drives DKG + tally; the config's
                                      # result_publisher_key (signs/sends the result). On chain
                                      # it is also the funded relayer (pays gas for keyper meta-tx)
                                      # and holds RESULT_PUBLISHER_ROLE. Its 20-byte address is
                                      # COORDINATOR_IDENTITY — hand that to keyper operators.
COORDINATOR_API_TOKEN=<url-safe token>  # coordinator relay (:8400) bearer; the coordinator pushes it to keypers via bootstrap

# --- blockchain backend only ----------------------------------------------- #
GEG_CHAIN_RPC=http://anvil:8545
GEG_REGISTRY_ADDRESS=0x<address>      # set after `deploy-registry` (RUNNING.md)
